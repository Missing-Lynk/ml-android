<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:titleTextColor="?attr/colorOnSurface" />

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <!-- the player attaches its render view here at runtime (index 0) -->

        <LinearLayout
            android:id="@+id/status_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/status_image"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@string/stay_tuned_image"
                android:src="@drawable/ic_stay_tuned"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Searching for goggles…" />

            <TextView
                android:id="@+id/status_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect"
                android:visibility="gone" />
        </LinearLayout>

        <!-- shown transiently on tap while fullscreen; disconnects back to the main screen -->
        <ImageButton
            android:id="@+id/fullscreen_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_scrim_circle"
            android:contentDescription="@string/disconnect"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <!-- Stays on screen for as long as the restream is armed, unlike the controls, which
             hide themselves: whether a session is being broadcast has to be readable at a
             glance, without touching the display and covering the picture.

             Bottom-left because Android draws its own microphone and camera indicator in the
             top-right corner, and this is the one overlay that is always up. -->
        <TextView
            android:id="@+id/stream_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:maxWidth="220dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="@drawable/bg_scrim_pill"
            android:drawablePadding="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_dot_live"
            tools:text="Streaming"
            tools:visibility="visible" />

        <!-- What the goggle is sending. Revealed with the controls, because it is what says
             whether a destination will take the stream, and Twitch and Kick take H.264 only.
             It takes the top-right corner, where a chip that only appears on a tap can share
             the space with the system's own indicator. -->
        <TextView
            android:id="@+id/stream_codec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_scrim_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@android:color/white"
            android:visibility="gone"
            tools:text="H.265"
            tools:visibility="visible" />

        <!-- Sits over a picture the decoder is holding because the feed stopped while the
             session stayed open. Centred, because the picture behind it is frozen and a chip in
             a corner reads as a still shot rather than a stopped one. -->
        <TextView
            android:id="@+id/feed_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_scrim_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@android:color/white"
            android:visibility="gone"
            tools:text="No video from the air unit"
            tools:visibility="visible" />

        <!-- revealed by the same tap as the back control; arms and disarms the restream, so a
             session can be previewed before anything is broadcast -->
        <ImageButton
            android:id="@+id/stream_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_scrim_circle"
            android:contentDescription="@string/stream_start"
            android:padding="10dp"
            android:src="@drawable/ic_stream_start"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </FrameLayout>

</LinearLayout>
