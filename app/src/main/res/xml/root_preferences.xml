<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:key="@string/pref_url_key"
        app:title="@string/pref_url_title"
        app:defaultValue="@string/default_rtsp_url"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <!-- non-clickable note under the URL field -->
    <Preference
        app:summary="@string/pref_url_note"
        app:selectable="false"
        app:iconSpaceReserved="false" />

    <!-- Opens the destinations screen; SettingsFragment fills the summary with the active
         entry's name, which is what keeps a stream key off this screen. -->
    <Preference
        app:key="@string/pref_destinations_key"
        app:title="@string/pref_rtmp_title"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
