<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup, used on API 30 and below (API 31+ reads data_extraction_rules.xml).

   The only thing worth carrying to a new phone is the stream URL preference. Naming an
   <include> makes the backup exclusive, so the diagnostics log under the external files dir
   is left behind: it is a record of one phone's sessions, up to 256 KB of it, and means
   nothing on the device it is restored onto.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
